using "platforms/cpus/stm32h753.repl"
// VII-A: candidate (a). The stock rcc's registration cancelled; the spike wrapper SpikeRcc, which owns an
// unregistered stock STM32H7_RCC and forwards to it, at the RCC's address; and all 58 stock registrations restated
// onto it, generated by rcc/restate.awk from the stock stm32h7.repl.
rcc: @none

rccg: Tviburi1150.SpikeRcc @ sysbus 0x58024400
    systick: nvic

adc3: @ {
        sysbus 0x58026000;
        rccg RegistrationPeripheralAlias.ADC3
    }

bdma: @ {
        sysbus 0x58025400;
        rccg RegistrationPeripheralAlias.BDMA
    }

gpioPortK: @ {
        sysbus <0x58022800, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOK
    }

gpioPortJ: @ {
        sysbus <0x58022400, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOJ
    }

gpioPortI: @ {
        sysbus <0x58022000, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOI
    }

gpioPortH: @ {
        sysbus <0x58021C00, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOH
    }

gpioPortG: @ {
        sysbus <0x58021800, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOG
    }

gpioPortF: @ {
        sysbus <0x58021400, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOF
    }

gpioPortE: @ {
        sysbus <0x58021000, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOE
    }

gpioPortD: @ {
        sysbus <0x58020C00, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOD
    }

gpioPortC: @ {
        sysbus <0x58020800, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOC
    }

gpioPortB: @ {
        sysbus <0x58020400, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOB
    }

gpioPortA: @ {
        sysbus <0x58020000, +0x400>;
        rccg RegistrationPeripheralAlias.GPIOA
    }

rtc: @ {
        sysbus 0x58004000;
        rccg RegistrationPeripheralAlias.RTC
    }

spi4: @ {
        sysbus 0x40013400;
        rccg RegistrationPeripheralAlias.SPI4
    }

i2c4: @ {
        sysbus 0x58001C00;
        rccg RegistrationPeripheralAlias.I2C4
    }

lpuart1: @ {
        sysbus 0x58000C00;
        rccg RegistrationPeripheralAlias.LPUART1
    }

syscfg: @ {
        sysbus 0x58000400;
        rccg RegistrationPeripheralAlias.SYSCFG
    }

dma2d: @ {
        sysbus 0x52001000;
        rccg RegistrationPeripheralAlias.DMA2D
    }

ltdc: @ {
        sysbus 0x50001000;
        rccg RegistrationPeripheralAlias.LTDC
    }

adcM1S2: @ {
        sysbus 0x40022000;
        rccg RegistrationPeripheralAlias.ADC12
    }

rng: @ {
        sysbus 0x48021800;
        rccg RegistrationPeripheralAlias.RNG
    }

dma2: @ {
        sysbus 0x40020400;
        rccg RegistrationPeripheralAlias.DMA2
    }

dma1: @ {
        sysbus 0x40020000;
        rccg RegistrationPeripheralAlias.DMA1
    }

timer17: @ {
        sysbus 0x40014800;
        rccg RegistrationPeripheralAlias.TIM17
    }

timer16: @ {
        sysbus 0x40014400;
        rccg RegistrationPeripheralAlias.TIM16
    }

timer15: @ {
        sysbus 0x40014000;
        rccg RegistrationPeripheralAlias.TIM15
    }

usart6: @ {
        sysbus 0x40011400;
        rccg RegistrationPeripheralAlias.USART6
    }

usart1: @ {
        sysbus 0x40011000;
        rccg RegistrationPeripheralAlias.USART1
    }

timer8: @ {
        sysbus 0x40010400;
        rccg RegistrationPeripheralAlias.TIM8
    }

timer1: @ {
        sysbus 0x40010000;
        rccg RegistrationPeripheralAlias.TIM1
    }

uart8: @ {
        sysbus 0x40007C00;
        rccg RegistrationPeripheralAlias.UART8
    }

uart7: @ {
        sysbus 0x40007800;
        rccg RegistrationPeripheralAlias.UART7
    }

i2c3: @ {
        sysbus 0x40005C00;
        rccg RegistrationPeripheralAlias.I2C3
    }

i2c2: @ {
        sysbus 0x40005800;
        rccg RegistrationPeripheralAlias.I2C2
    }

i2c1: @ {
        sysbus 0x40005400;
        rccg RegistrationPeripheralAlias.I2C1
    }

uart5: @ {
        sysbus 0x40005000;
        rccg RegistrationPeripheralAlias.UART5
    }

uart4: @ {
        sysbus 0x40004C00;
        rccg RegistrationPeripheralAlias.UART4
    }

usart3: @ {
        sysbus 0x40004800;
        rccg RegistrationPeripheralAlias.USART3
    }

usart2: @ {
        sysbus 0x40004400;
        rccg RegistrationPeripheralAlias.USART2
    }

timer14: @ {
        sysbus 0x40002000;
        rccg RegistrationPeripheralAlias.TIM14
    }

timer13: @ {
        sysbus 0x40001C00;
        rccg RegistrationPeripheralAlias.TIM13
    }

timer12: @ {
        sysbus 0x40001800;
        rccg RegistrationPeripheralAlias.TIM12
    }

timer7: @ {
        sysbus 0x40001400;
        rccg RegistrationPeripheralAlias.TIM7
    }

timer6: @ {
        sysbus 0x40001000;
        rccg RegistrationPeripheralAlias.TIM6
    }

timer5: @ {
        sysbus 0x40000C00;
        rccg RegistrationPeripheralAlias.TIM5
    }

timer4: @ {
        sysbus 0x40000800;
        rccg RegistrationPeripheralAlias.TIM4
    }

timer3: @ {
        sysbus 0x40000400;
        rccg RegistrationPeripheralAlias.TIM3
    }

timer2: @ {
        sysbus 0x40000000;
        rccg RegistrationPeripheralAlias.TIM2
    }

crc: @ {
        sysbus 0x58024C00;
        rccg RegistrationPeripheralAlias.CRC
    }

lptimer1: @ {
        sysbus 0x40002400;
        rccg RegistrationPeripheralAlias.LPTIM1
    }

lptimer2: @ {
        sysbus 0x58002400;
        rccg RegistrationPeripheralAlias.LPTIM2
    }

lptimer3: @ {
        sysbus 0x58002800;
        rccg RegistrationPeripheralAlias.LPTIM3
    }

lptimer4: @ {
        sysbus 0x58002C00;
        rccg RegistrationPeripheralAlias.LPTIM4
    }

lptimer5: @ {
        sysbus 0x58003000;
        rccg RegistrationPeripheralAlias.LPTIM5
    }

hsem: @ {
        sysbus 0x58026400;
        rccg RegistrationPeripheralAlias.HSEM
    }

ethernet: @ {
        sysbus 0x40028000;
        sysbus new Bus.BusMultiRegistration { address: 0x40028C00; size: 0x200; region: "mtl" };
        sysbus new Bus.BusMultiRegistration { address: 0x40029000; size: 0x200; region: "dma" };
        rccg RegistrationPeripheralAlias.ETH1MAC
    }

qspi: @ {
        sysbus 0x52005000;
        rccg RegistrationPeripheralAlias.QSPI
    }

