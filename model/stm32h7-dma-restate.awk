# TVI-WO-1303: model/stm32h7-dma-restate.repl from Renode 1.17.0's pinned platforms/cpus/stm32h7.repl (RUL-07; RUL-09
# (b)), as model/stm32h7-timer-restate.awk does the timers'. Each typed entry `dma1:`/`dma2: DMA.STM32DMA @ { ... }`: the
# stock controller cancelled (`dmaN: @none`), the guard declared at its address `as "dmaN"` with the same block (its `rcc`
# registration on `tviburiRcc`), the stock DMAMUX1 as its `dmamux`, and the same interrupt lines. Then DMAMUX1's routes
# to either controller, restated by an untyped `dmamux1:` update onto the guards' variables: DMAMUX1 itself is not
# cancelled, so every other reference to it (a peripheral's request line, an ADC's dmaPeripheral) still binds (ruled
# 2026-11-24T14:10Z Q1; measured, TVI-WO-1303.measure.md §2.3).
# Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-dma-restate.awk stm32h7.repl
function flush(   b) {
    if (name != "") {
        print name ": @none"
        print ""
        b = blk; gsub(/ rcc RegistrationPeripheralAlias/, " tviburiRcc RegistrationPeripheralAlias", b)
        print "tviburiD" substr(name, 2) ": Tviburi.GuardedSTM32DMA @ {"
        printf "%s", b
        print "    } as \"" name "\""
        print "    dmamux: dmamux1"
        printf "%s", tail
        print ""
        n++
    }
    name = ""; blk = ""; tail = ""
}
BEGIN {
    print "// GENERATED by model/stm32h7-dma-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. DMA1 and DMA2 cancelled, the guard declared at each address under its name,"
    print "// with the stock entry's registration (on tviburiRcc) and interrupt lines and the stock DMAMUX1 as its `dmamux`,"
    print "// then DMAMUX1's routes restated onto the guards (RUL-07; RUL-09 (b)). A property for a controller (mode) goes on"
    print "// `tviburiDmaN`: an untyped `dmaN:` update binds to the cancelled stock entry, with no error."
    print ""
}
/^dma[12]: DMA\.STM32DMA @ \{$/ { flush(); name = $1; sub(/:$/, "", name); inblk = 1; next }
name != "" && inblk && /^ *\}/ { inblk = 0; next }
name != "" && inblk { blk = blk $0 "\n"; next }
name != "" && /^ +[^ ]/ { tail = tail $0 "\n"; next }
name != "" { flush() }
/^dmamux1: / { mux = 1; next }
mux && /^ +[^ ]/ { if ($0 ~ /-> dma[12]@/) { l = $0; gsub(/-> dma/, "-> tviburiDma", l); routes = routes l "\n" }; next }
mux { mux = 0 }
END {
    flush()
    print "dmamux1:"
    printf "%s", routes
    print ""
    print "// " n " DMA controllers restated."
}
