# TVI-WO-1301: model/stm32h7-gpio-restate.repl from Renode 1.17.0's pinned platforms/cpus/stm32h7.repl (RUL-07;
# RUL-09 (b)), as model/stm32h7-rcc-restate.awk does the RCC's. Measured at §1.1 as a prototype (in git history).
# - Each typed port entry `gpioPortX: GPIOPort.STM32_GPIOPort @ { ... }`, with its properties and connections: the
#   stock port cancelled (`gpioPortX: @none`), the guard declared at its address `as "gpioPortX"` with the same block
#   (its `rcc` registration on `tviburiRcc`, as the RCC's restatement has it), the same properties and `-> syscfg`
#   line, and silicon's reset values, which the stock file does not pass (RM0433 Rev 9 §11.4.1 p541 MODER;
#   §11.4.3-11.4.4 p542 OSPEEDR, PUPDR). The guard checks them against its port.
# - Each untyped update block that names a port (the timers' outputs into a port's AF receivers,
#   `timerN: k -> gpioPortX#pin@af`; a port's pins into the timers, `gpioPortX: k -> timerN@m`): restated with every
#   `gpioPortX` replaced by the guard's variable `tviburiGpioX`.
# A cancelled port's connections stay in Renode's CombinedInput combiners as inputs that never drive (measured,
# TVI-WO-1301.rm0433.md §4).
# TVI-WO-1302 (ruled 2026-11-24T06:10Z Q3): TIM1 and TIM8 are guarded too, so a block's `timer1`/`timer8` is the guard's
# variable `tviburiTimer1`/`tviburiTimer8` (model/stm32h7-timer-restate.repl). Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-gpio-restate.awk stm32h7.repl
function flush(   b, m, o, u) {
    if (kind == "port") {
        print name ": @none"
        print ""
        sub(/^gpioPort/, "", name); letter = name
        b = blk; gsub(/ rcc RegistrationPeripheralAlias/, " tviburiRcc RegistrationPeripheralAlias", b)
        print "tviburiGpio" letter ": Tviburi.GuardedSTM32_GPIOPort @ {"
        printf "%s", b
        print "    } as \"gpioPort" letter "\""
        m = letter == "A" ? "0xABFFFFFF" : letter == "B" ? "0xFFFFFEBF" : "0xFFFFFFFF"
        o = letter == "A" ? "0x0C000000" : letter == "B" ? "0x000000C0" : "0x0"
        u = letter == "A" ? "0x64000000" : letter == "B" ? "0x00000100" : "0x0"
        print "    modeResetValue: " m; print "    outputSpeedResetValue: " o; print "    pullUpPullDownResetValue: " u
        printf "%s", tail
        print ""
        ports++
    } else if (kind == "update" && (name ~ /^gpioPort[A-K]$/ || blk ~ /gpioPort[A-K]/)) {
        b = (name ~ /^timer[18]$/ ? "tviburiT" substr(name, 2) : name) ":\n" blk
        gsub(/gpioPort/, "tviburiGpio", b); gsub(/timer1@/, "tviburiTimer1@", b); gsub(/timer8@/, "tviburiTimer8@", b)
        printf "%s\n", b
        updates++
    }
    kind = ""; blk = ""; tail = ""
}
BEGIN {
    print "// GENERATED by model/stm32h7-gpio-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. Each stock GPIO port cancelled, the guard declared at its address under its"
    print "// name with silicon's reset values, and every stock connection that names a port restated onto the guard's"
    print "// variable (RUL-07; RUL-09 (b)). A property for a port (mode, package) goes on `tviburiGpioX`: an untyped"
    print "// `gpioPortX:` update binds to the cancelled stock entry, with no error, and never reaches the guard (TVI-WO-1150 (i), n3)."
    print ""
}
/^[A-Za-z0-9_]+: GPIOPort\.STM32_GPIOPort @ \{$/ { flush(); kind = "port"; name = $1; sub(/:$/, "", name); inblk = 1; next }
kind == "port" && inblk && /^ *\}/ { inblk = 0; next }
kind == "port" && inblk { blk = blk $0 "\n"; next }
kind == "port" && /^[A-Za-z0-9_]+:/ { flush() }
kind == "port" { if ($0 !~ /^ *$/) tail = tail $0 "\n"; next }
/^[A-Za-z0-9_]+:$/ { flush(); kind = "update"; name = $1; sub(/:$/, "", name); next }
kind == "update" && /^ +/ { blk = blk $0 "\n"; next }
/^[^ ]/ { flush() }
END { flush(); print "// " ports " ports restated; " updates " connection blocks restated." }
