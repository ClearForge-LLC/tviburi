# TVI-WO-1307: model/stm32h7-adc-restate.repl from Renode 1.17.0's pinned stm32h7.repl, as stm32h7-i2c-restate.awk does the
# I2C ports'; what it writes is said in the header it prints. A typed redeclaration of `adc3` is refused (E02: the stock
# entry comes from the `using` file), so each ADC is cancelled and restated: measured as a form in TVI-WO-1307.measure.md
# §2.3 (F).
# Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-adc-restate.awk stm32h7.repl
function flush(   b, v) {
    if (name != "") {
        v = name == "adc3" ? "tviburiAdc3" : "tviburiAdc12"
        print name ": @none"
        print ""
        b = blk; gsub(/ rcc RegistrationPeripheralAlias/, " tviburiRcc RegistrationPeripheralAlias", b)
        print v ": Tviburi.GuardedSTM32H7_ADC @ {"
        printf "%s", b
        print "    } as \"" name "\""
        printf "%s", tail
        print ""
        n++
    }
    name = ""; blk = ""; tail = ""; state = 0
}
BEGIN {
    print "// GENERATED by model/stm32h7-adc-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. ADC3 and the ADC1/ADC2 pair (adcM1S2) cancelled, the guard declared at each"
    print "// address under its name, with the stock entry's registration (on tviburiRcc), properties and interrupt line (RUL-07;"
    print "// RUL-09 (b)). A property for an ADC (mode, revision, levels) goes on `tviburiAdc3` / `tviburiAdc12`: an untyped"
    print "// `adc3:` update binds to the cancelled stock entry."
    print ""
}
state == 2 && /^    [^ }]/ { tail = tail $0 "\n"; next }
state == 2 { flush() }
state == 1 && /^    }$/ { state = 2; next }
state == 1 { blk = blk $0 "\n"; next }
/^(adc3|adcM1S2): Analog\.STM32H7_ADC @ \{$/ { name = $1; sub(/:$/, "", name); state = 1; next }
END { flush(); print "// " n " ADCs restated." }
