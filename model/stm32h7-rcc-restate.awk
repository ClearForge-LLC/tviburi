# TVI-WO-1300: model/stm32h7-rcc-restate.repl from Renode 1.17.0's pinned platforms/cpus/stm32h7.repl (RUL-07; RUL-09 (b)).
# It cancels the stock `rcc` (sealed, so not re-typable), declares Tviburi's wrapper at the stock address as "rcc", and
# restates every stock registration on `rcc RegistrationPeripheralAlias.X` onto the wrapper, as an untyped update whose
# block keeps the entry's bus address. From spike/1150/rcc/restate.awk. Its output is committed beside it.
# TVI-WO-1302 (ruled 2026-11-24T06:10Z Q3): timer1 and timer8 are left out; model/stm32h7-timer-restate.repl declares
# each guard with its registration on tviburiRcc.
# Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-rcc-restate.awk stm32h7.repl > stm32h7-rcc-restate.repl
BEGIN {
    print "// GENERATED by model/stm32h7-rcc-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. The stock rcc cancelled, the guard declared at its address under its"
    print "// name, and each stock registration on rcc restated onto the guard (RUL-07; RUL-09 (b))."
    print "// A property for the RCC (hseFrequency, csiFrequency, mode) goes on `tviburiRcc`: an untyped `rcc:` update"
    print "// binds to the cancelled stock entry, with no error, and never reaches the guard (TVI-WO-1150 (i), n3)."
    print ""
    print "rcc: @none"
    print ""
    print "tviburiRcc: Tviburi.GuardedSTM32H7_RCC @ sysbus 0x58024400 as \"rcc\""
    print "    systick: nvic"
    print ""
}
/^[A-Za-z0-9_]+: .* @ \{$/ { name = $1; sub(/:$/, "", name); inblk = 1; blk = ""; hasrcc = 0; next }
inblk && /^ *\}/ { inblk = 0; if (hasrcc && name !~ /^timer[18]$/) { print name ": @ {"; printf "%s", blk; print "    }"; print ""; n++ }; next }
inblk { line = $0; if (line ~ /^ *rcc RegistrationPeripheralAlias\./) { hasrcc = 1; sub(/rcc /, "tviburiRcc ", line) }; blk = blk line "\n" }
END { print "// " n " registrations restated." }
