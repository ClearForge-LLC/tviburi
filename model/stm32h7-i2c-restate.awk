# TVI-WO-1306: model/stm32h7-i2c-restate.repl from Renode 1.17.0's pinned stm32h7.repl, as stm32h7-usart-restate.awk does the
# USARTs'; what it writes is said in the header it prints. Measured as a form in TVI-WO-1306.measure.md §2.4.
# Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-i2c-restate.awk stm32h7.repl
function flush(   b, v) {
    if (name != "") {
        v = "tviburiI2c" substr(name, 4)
        print name ": @none"
        print ""
        b = blk; gsub(/ rcc RegistrationPeripheralAlias/, " tviburiRcc RegistrationPeripheralAlias", b)
        print v ": Tviburi.GuardedSTM32F7_I2C @ {"
        printf "%s", b
        print "    } as \"" name "\""
        printf "%s", tail
        print ""
        n++
    }
    name = ""; blk = ""; tail = ""; state = 0
}
BEGIN {
    print "// GENERATED by model/stm32h7-i2c-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. I2C1, I2C2 and I2C3 cancelled, the guard declared at each address under its"
    print "// name, with the stock entry's registration (on tviburiRcc) and interrupt lines (RUL-07; RUL-09 (b)). A property"
    print "// for a port (mode) goes on `tviburiI2cN`, and a sensor is declared `@ tviburiI2cN 0xAA`: an `@ i2cN` binds to the"
    print "// cancelled stock entry and the load fails (E39). i2c4 (D3 domain) stays stock (ruled 2026-11-25T05:06Z Q1)."
    print ""
}
state == 2 && /^    [^ }]/ { tail = tail $0 "\n"; next }
state == 2 { flush() }
state == 1 && /^    }$/ { state = 2; next }
state == 1 { blk = blk $0 "\n"; next }
/^i2c[123]: I2C\.STM32F7_I2C @ \{$/ { name = $1; sub(/:$/, "", name); state = 1; next }
END { flush(); print "// " n " I2C ports restated." }
