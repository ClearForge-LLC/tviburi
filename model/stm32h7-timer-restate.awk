# TVI-WO-1302: model/stm32h7-timer-restate.repl from Renode 1.17.0's pinned platforms/cpus/stm32h7.repl (RUL-07;
# RUL-09 (b)), as model/stm32h7-rcc-restate.awk and model/stm32h7-gpio-restate.awk do the RCC's and the ports'.
# Each typed entry `timer1:`/`timer8: Timers.STM32_Timer @ { ... }`: the stock timer cancelled (`timerN: @none`), the
# guard declared at its address `as "timerN"` with the same block (its `rcc` registration on `tviburiRcc`) and the
# same properties and interrupt lines. The routes that name either timer are the GPIO restatement's, on the guard's
# variable (ruled 2026-11-24T06:10Z Q3). Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-timer-restate.awk stm32h7.repl
function flush(   b) {
    if (name != "") {
        print name ": @none"
        print ""
        b = blk; gsub(/ rcc RegistrationPeripheralAlias/, " tviburiRcc RegistrationPeripheralAlias", b)
        print "tviburiT" substr(name, 2) ": Tviburi.GuardedSTM32_Timer @ {"
        printf "%s", b
        print "    } as \"" name "\""
        printf "%s", tail
        print ""
        n++
    }
    name = ""; blk = ""; tail = ""
}
BEGIN {
    print "// GENERATED by model/stm32h7-timer-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. TIM1 and TIM8 cancelled, the guard declared at each address under its name,"
    print "// with the stock entry's registration (on tviburiRcc), properties and interrupt lines (RUL-07; RUL-09 (b)). A"
    print "// property for a timer (frequency, mode) goes on `tviburiTimerN`: an untyped `timerN:` update binds to the"
    print "// cancelled stock entry, with no error, and never reaches the guard (measured, TVI-WO-1302.measure.md §2.3)."
    print ""
}
/^timer[18]: Timers\.STM32_Timer @ \{$/ { flush(); name = $1; sub(/:$/, "", name); inblk = 1; next }
name != "" && inblk && /^ *\}/ { inblk = 0; next }
name != "" && inblk { blk = blk $0 "\n"; next }
name != "" && /^ +[^ ]/ { tail = tail $0 "\n"; next }
name != "" { flush() }
END { flush(); print "// " n " timers restated." }
