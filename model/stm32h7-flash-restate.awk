# TVI-WO-1304: model/stm32h7-flash-restate.repl from Renode 1.17.0's pinned platforms/cpus/stm32h7.repl (RUL-07;
# RUL-09 (b)), as model/stm32h7-timer-restate.awk does the timers'. The typed entry `flashController:
# MTD.STM32H7_FlashController @ sysbus 0x52002000`: the stock controller cancelled (`flashController: @none`), the guard
# declared at its address `as "flashController"` with the same banks and interrupt line. The option-byte image
# (`optionBytes`) and the mode go on `tviburiFlash`: an untyped `flashController:` block on the cancelled entry with an
# `init` section fails the load (E29, measured, TVI-WO-1304.measure.md §2.4).
# Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-flash-restate.awk stm32h7.repl
BEGIN {
    print "// GENERATED by model/stm32h7-flash-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. The flash controller cancelled, the guard declared at its address under its"
    print "// name, with the stock entry's banks and interrupt line (RUL-07; RUL-09 (b)). Its properties (optionBytes, mode) go"
    print "// on `tviburiFlash`: an untyped `flashController:` block with an `init` section, on the cancelled entry, fails the"
    print "// load (E29, measured, TVI-WO-1304.measure.md §2.4)."
    print ""
}
/^flashController: MTD\.STM32H7_FlashController @ sysbus 0x52002000$/ {
    print "flashController: @none"
    print ""
    print "tviburiFlash: Tviburi.GuardedSTM32H7_Flash @ sysbus 0x52002000 as \"flashController\""
    f = 1; n++; next
}
f && /^ +[^ ]/ { print; next }
f { f = 0 }
END { print ""; print "// " n " flash controller restated." }
