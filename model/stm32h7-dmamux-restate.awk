# TVI-WO-1308: model/stm32h7-dmamux-restate.repl from Renode 1.17.0's pinned stm32h7.repl, as stm32h7-adc-restate.awk does the
# ADCs'; what it writes is said in the header it prints. DMAMUX1 is cancelled and restated as the guard (ruled 2026-11-26T09:31Z
# Q1), so every other reference to the variable `dmamux1` must be restated onto `tviburiDmamux1`, or it binds to the cancelled
# entry with no error (measured, TVI-WO-1308.measure.md §4): each one this file declares, by an untyped update in this file,
# and the two the generator cannot read (the DMA guards' `dmamux`, from model/stm32h7-dma-restate.repl; `crypto`'s, from
# stm32h753.repl L5), as fixed lines.
# Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-dmamux-restate.awk stm32h7.repl
BEGIN {
    print "// GENERATED by model/stm32h7-dmamux-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. DMAMUX1 cancelled and the guard declared at its address under its name, with"
    print "// the stock entry's properties and its routes onto the DMA guards (RUL-07; RUL-09 (b)); then every other reference to"
    print "// the variable `dmamux1` restated onto `tviburiDmamux1` by an untyped update (an unrestated one binds to the cancelled"
    print "// entry with no error). Load after stm32h7-dma-restate.repl and stm32h7-adc-restate.repl, whose guards it updates. A"
    print "// property for DMAMUX1 (mode) goes on `tviburiDmamux1`. A platform's own `-> dmamux1@N` lines must be repointed too."
    print ""
    var["adc3"] = "tviburiAdc3"; var["adcM1S2"] = "tviburiAdc12"
}
/^[A-Za-z_][A-Za-z0-9_]*:/ { entry = $1; sub(/:$/, "", entry); mux = 0 }
/^dmamux1: Miscellaneous\.STM32_DMAMUX @ / { at = $0; sub(/^dmamux1: Miscellaneous\.STM32_DMAMUX /, "", at); mux = 1; next }
mux && /^    [^ ]/ { l = $0; gsub(/-> dma/, "-> tviburiDma", l); body = body l "\n"; next }
/^    dmaPeripheral: dmamux1$/ {
    refs = refs "// stm32h7.repl L" NR " (" entry ")\n" (entry in var ? var[entry] : entry) ":\n    dmaPeripheral: tviburiDmamux1\n\n"; n++; next
}
/^    [A-Za-z]+ -> dmamux1@[0-9]+$/ {
    l = $0; sub(/-> dmamux1@/, "-> tviburiDmamux1@", l)
    refs = refs "// stm32h7.repl L" NR " (" entry ")\n" entry ":\n" l "\n\n"; n++; next
}
END {
    print "dmamux1: @none"
    print ""
    print "tviburiDmamux1: Tviburi.GuardedSTM32H7_DMAMUX " at " as \"dmamux1\""
    printf "%s", body
    print ""
    print "// model/stm32h7-dma-restate.repl (Tviburi's own, TVI-WO-1303): each DMA guard's `dmamux`"
    print "tviburiDma1:"
    print "    dmamux: tviburiDmamux1"
    print ""
    print "tviburiDma2:"
    print "    dmamux: tviburiDmamux1"
    print ""
    printf "%s", refs
    print "// platforms/cpus/stm32h753.repl L5 (crypto), sha256 13c5571ea3c2a66d23d7dc5e49d09c6013d31c946abdbfc450aebb08929d10ce, the"
    print "// pinned chain's first file, which this generator does not read: a platform without `crypto` must drop these two lines"
    print "crypto:"
    print "    OutDMA -> tviburiDmamux1@77"
    print ""
    print "// DMAMUX1 restated; " n + 3 " references to it restated."
}
