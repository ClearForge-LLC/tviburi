# TVI-WO-1308: model/stm32h7-pwr-restate.repl from Renode 1.17.0's pinned stm32h7.repl, as stm32h7-dmamux-restate.awk does
# DMAMUX1's; what it writes is said in the header it prints. The stock `pwr` is a Python script (stm32h7.repl L728-746), so there is
# nothing to subclass: it is cancelled and the PWR guard, a Tviburi-authored model, declared at its address under its name (ruled
# 2026-11-26T09:31Z Q13). Nothing else in the pinned file refers to `pwr`, and the stub's properties (size, initable, script) are
# the stub's own, so none is restated. The board does not load this file (ruled 10:08Z Q17 (a)).
# Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-pwr-restate.awk stm32h7.repl
BEGIN {
    print "// GENERATED by model/stm32h7-pwr-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. The stock `pwr` (a Python script) cancelled and the PWR guard declared at its"
    print "// address under its name (RUL-09 (b); TVI-WO-1308 Q13). A platform's own untyped `pwr:` update (a script) would bind to the"
    print "// cancelled entry and must be dropped. Its properties (mode, and `revision`, \"V\" or \"Y\", required) go on `tviburiPwr`."
    print ""
}
/^pwr: Python\.PythonPeripheral @ / { at = $0; sub(/^pwr: Python\.PythonPeripheral /, "", at); line = NR; next }
END {
    if(at == "") { print "stm32h7-pwr-restate.awk: no stock pwr entry" > "/dev/stderr"; exit 1 }
    print "// stm32h7.repl L" line " (pwr)"
    print "pwr: @none"
    print ""
    print "tviburiPwr: Tviburi.GuardedSTM32H7_PWR " at " as \"pwr\""
    print ""
    print "// PWR restated."
}
