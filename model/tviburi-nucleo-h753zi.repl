// Tviburi overlay of Renode 1.17.0's NUCLEO-H753ZI board.
// Stock Renode only Tags SPI1 (0x40013000, "SPI1_/_I2S1"); this registers the guarded
// STM32H7_SPI there, in the mode this file names (RUL-19). The stock RCC is sealed, so the RCC guard is a wrapper:
// stm32h7-rcc-restate.repl cancels the stock `rcc`, declares the guard as "rcc" and restates its 58 registrations
// (RUL-07; RUL-09 (b)). Requires the release's one C# file (tools/tviburi-release) to be included first; without it
// this file fails to load.
using "platforms/boards/nucleo_h753zi.repl"
using "./stm32h7-rcc-restate.repl"
using "./stm32h7-gpio-restate.repl"
using "./stm32h7-timer-restate.repl"
using "./stm32h7-flash-restate.repl"

// The guard's mode (RUL-19), and the stock board's `rcc: hseFrequency: 8_000_000` restated on the guard: that update
// lands on the cancelled stock entry (TVI-WO-1300.rm0433.md §6.4).
tviburiRcc:
    hseFrequency: 8000000
    mode: "enforcing"

spi1: Tviburi.GuardedSTM32H7_SPI @ {
        sysbus 0x40013000;
        tviburiRcc RegistrationPeripheralAlias.SPI1
    }
    mode: "enforcing"

// TVI-WO-1301: the GPIO ports are guarded (stm32h7-gpio-restate.repl cancels each stock port and declares the guard as
// "gpioPortX"). Each port's mode (RUL-19) and the package the board's part is in, as the guard's property, never a
// variable or a path (RUL-10): the NUCLEO-H753ZI carries an STM32H753ZIT6 (from memory: its user manual, UM2407, is not
// held), and in DS12117 Rev 10's ordering scheme "Z = 144 pins" and "T = LQFP" (§9 p346), so LQFP144, whose bonding is
// model/ds12117-rev10-lqfp144.tsv (Table 8 p64-88, Figure 6 p57).
tviburiGpioA:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioB:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioC:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioD:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioE:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioF:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioG:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioH:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioI:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioJ:
    mode: "enforcing"
    package: "LQFP144"

tviburiGpioK:
    mode: "enforcing"
    package: "LQFP144"

// TVI-WO-1302: TIM1 and TIM8 are guarded (stm32h7-timer-restate.repl cancels each stock timer and declares the guard
// as "timer1"/"timer8"; the GPIO restatement routes their channels to the guard's variable). Each timer's mode (RUL-19).
tviburiTimer1:
    mode: "enforcing"
tviburiTimer8:
    mode: "enforcing"
// TVI-WO-1304: the flash controller is guarded (stm32h7-flash-restate.repl cancels the stock controller and declares the
// guard as "flashController"). Its mode (RUL-19), and the option-byte image this board's part holds, served as
// FLASH_OPTSR_CUR (ruled 2026-11-24T15:50Z Q3): 0x1BC6AAF0, read from a NUCLEO-H753ZI rev V on the bench (Aethelgard
// AET-WO-3302, 2026-11-16; named in Aethelgard's ledger.rs FLASH OPTSR_CUR row). Never the stock model's reset value.
tviburiFlash:
    mode: "enforcing"
    optionBytes: 0x1BC6AAF0
// The stock board's LEDs and button are registered on, and connected to, the cancelled ports: restated onto the guards
// (without this the load fails, E39, and Renode exits 0: TVI-WO-1301.rm0433.md §6.5).
GreenLED: @ tviburiGpioB 0
YellowLED: @ tviburiGpioE 1
RedLED: @ tviburiGpioB 14

UserButton1: @ tviburiGpioC 13
    -> tviburiGpioC@13

tviburiGpioB:
    0 -> GreenLED@0
    14 -> RedLED@0

tviburiGpioE:
    1 -> YellowLED@0
