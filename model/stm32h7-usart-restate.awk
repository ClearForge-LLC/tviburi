# TVI-WO-1305: model/stm32h7-usart-restate.repl from Renode 1.17.0's pinned stm32h7.repl, as stm32h7-dma-restate.awk does the
# DMA controllers'; what it writes is said in the header it prints. Measured as a form in TVI-WO-1305.measure.md §2.3.
# Usage: awk -v sha=<sha256 of stm32h7.repl> -f stm32h7-usart-restate.awk stm32h7.repl
function flush(   b, v) {
    if (name != "") {
        v = "tviburiU" substr(name, 2)
        print name ": @none"
        print ""
        b = blk; gsub(/ rcc RegistrationPeripheralAlias/, " tviburiRcc RegistrationPeripheralAlias", b)
        print v ": Tviburi.GuardedSTM32F7_USART @ {"
        printf "%s", b
        print "    } as \"" name "\""
        printf "%s", tail
        print ""
        n++
    }
    name = ""; blk = ""; tail = ""; state = 0
}
BEGIN {
    print "// GENERATED by model/stm32h7-usart-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". Do not edit; regenerate. The eight USART/UARTs cancelled, the guard declared at each address under its"
    print "// name, with the stock entry's registration (on tviburiRcc), frequency and interrupt line (RUL-07; RUL-09 (b)). A"
    print "// property for a port (mode, a receive request line) goes on `tviburiUsartN`/`tviburiUartN`: an untyped `usartN:`"
    print "// update binds to the cancelled stock entry, with no error. lpuart1 stays stock."
    print ""
}
state == 2 && /^    [^ }]/ { tail = tail $0 "\n"; next }
state == 2 { flush() }
state == 1 && /^    }$/ { state = 2; next }
state == 1 { blk = blk $0 "\n"; next }
/^(usart|uart)[0-9]+: UART\.STM32F7_USART @ \{$/ { name = $1; sub(/:$/, "", name); state = 1; next }
END { flush(); print "// " n " USART/UARTs restated." }
