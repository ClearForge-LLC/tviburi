logFile @/out/renode-log.txt
include @/out/onefile.cs
emulation SetSeed 1
mach create
machine LoadPlatformDescription @/proto/nucleo-1301.repl
peripherals
include @/h/checks.py
sysbus WriteDoubleWord 0x58020418 0x1
echo "GREEN-AFTER-BS0"
sysbus.gpioPortB.GreenLED State
sysbus WriteDoubleWord 0x58020418 0x10000
sysbus.gpioPortB.GreenLED State
sysbus.gpioPortC.UserButton1 Press
echo "IDR-C-AFTER-PRESS"
sysbus ReadDoubleWord 0x58020810
python "print('TVICHK signal PA5 ' + monitor.Machine['sysbus.gpioPortA'].WhichSignal(5))"
sysbus WriteDoubleWord 0x58020000 0xABFFF7FF
python "print('TVICHK signal PA5 ' + monitor.Machine['sysbus.gpioPortA'].WhichSignal(5))"
echo "TVIBURI-END"
quit
