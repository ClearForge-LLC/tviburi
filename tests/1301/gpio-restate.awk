# TVI-WO-1301 §1.1 (prototype; the build's generator goes to model/): the GPIO ports' restatement from Renode 1.17.0's
# pinned platforms/cpus/stm32h7.repl (RUL-07; RUL-09 (b)), as model/stm32h7-rcc-restate.awk does the RCC's.
# - Each typed port entry `gpioPortX: GPIOPort.STM32_GPIOPort @ { ... }` and its properties and connections: the stock
#   instance cancelled (`gpioPortX: @none`), the guard declared at its address `as "gpioPortX"`, with the same block
#   (its `rcc` registration on `tviburiRcc`, as the RCC's restatement has it), properties and `-> syscfg` lines.
# - Each untyped update block that names a port (the timers' outputs into a port's AF receivers,
#   `timerN: k -> gpioPortX#pin@af`; a port's pins into the timers, `gpioPortX: k -> timerN@m`): restated with every
#   `gpioPortX` replaced by the guard's variable `tviburiGpioX`.
# Usage: awk -v sha=<sha256 of stm32h7.repl> -v type=<guard type> -v props=<extra property lines, "\n"-separated>
#        [-v resets=1] -f gpio-restate.awk stm32h7.repl
# resets=1 adds silicon's reset values, which the stock file does not pass (RM0433 Rev 9 p541 MODER, p542 OSPEEDR and
# PUPDR): port A 0xABFFFFFF / 0x0C000000 / 0x64000000; port B 0xFFFFFEBF / 0x000000C0 / 0x00000100; others 0xFFFFFFFF / 0 / 0.
function flush(   i, b) {
    if (kind == "port") {
        print name ": @none"
        print ""
        sub(/^gpioPort/, "", name); letter = name
        b = blk; gsub(/ rcc RegistrationPeripheralAlias/, " tviburiRcc RegistrationPeripheralAlias", b)
        print "tviburiGpio" letter ": " type " @ {"
        printf "%s", b
        print "    } as \"gpioPort" letter "\""
        if (props != "") printf "%s\n", props
        if (resets) {
            m = letter == "A" ? "0xABFFFFFF" : letter == "B" ? "0xFFFFFEBF" : "0xFFFFFFFF"
            o = letter == "A" ? "0x0C000000" : letter == "B" ? "0x000000C0" : "0x0"
            u = letter == "A" ? "0x64000000" : letter == "B" ? "0x00000100" : "0x0"
            print "    modeResetValue: " m; print "    outputSpeedResetValue: " o; print "    pullUpPullDownResetValue: " u
        }
        printf "%s", tail
        print ""
        ports++
    } else if (kind == "update" && (name ~ /^gpioPort[A-K]$/ || blk ~ /gpioPort[A-K]/)) {
        b = name ":\n" blk
        gsub(/gpioPort/, "tviburiGpio", b)
        printf "%s\n", b
        updates++
    }
    kind = ""; blk = ""; tail = ""
}
BEGIN {
    print "// GENERATED by tests/1301/gpio-restate.awk from Renode 1.17.0's platforms/cpus/stm32h7.repl, sha256"
    print "// " sha ". The stock GPIO ports cancelled, the guard declared at each port's address under its name, and every"
    print "// stock connection that names a port restated onto the guard's variable (RUL-07; RUL-09 (b))."
    print ""
}
/^[A-Za-z0-9_]+: GPIOPort\.STM32_GPIOPort @ \{$/ { flush(); kind = "port"; name = $1; sub(/:$/, "", name); inblk = 1; next }
kind == "port" && inblk && /^ *\}/ { inblk = 0; next }
kind == "port" && inblk { blk = blk $0 "\n"; next }
kind == "port" && /^[A-Za-z0-9_]+:/ { flush() }
kind == "port" { if ($0 !~ /^ *$/) tail = tail $0 "\n"; next }
/^[A-Za-z0-9_]+:$/ { flush(); kind = "update"; name = $1; sub(/:$/, "", name); next }
kind == "update" && /^ +/ { blk = blk $0 "\n"; next }
/^[^ ]/ { flush() }
END { flush(); print "// " ports " ports restated; " updates " connection blocks restated." }
