# The Tviburi machine: refusal runtime, guarded model, pinned seed, overlay. Included by the runner
# and by tests/conditions.resc; the repository is mounted at /repo.
include @/repo/model/Refusal.cs
include @/repo/model/GuardedSTM32H7_SPI.cs
emulation SetSeed 1
mach create
machine LoadPlatformDescription @/repo/model/tviburi-nucleo-h753zi.repl
