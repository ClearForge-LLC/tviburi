#!/bin/sh
# monitor-output <renode console file>: the monitor's own output, as the runner and the tests read
# it. The monitor ends its lines with \r\r\n, and Renode prints log entries from another thread, so
# an entry can land mid-line, inside an echo (both measured); both are removed.
tr -d '\r' <"$1" | sed -zE 's/\[[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{4}\] \[[A-Z]+\] [^\n]*\n//g'
